# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Which provider /newpair uses: "mock" (default demo data), "onchain"
# (real PoolCreated watcher on Robinhood Chain, recommended), or
# "dexscreener" (name-search only, limited — see README).
SNIPER_SOURCE=mock

# Robinhood Chain RPC endpoint for the onchain provider. Defaults to the
# public rate-limited endpoint; set this to a dedicated RPC (Alchemy,
# etc.) for heavier polling.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# DexScreener chain id and search query, used by the dexscreener provider
# and by onchain's DexScreener enrichment step.
DEX_CHAIN_ID=robinhood
DEX_SEARCH_QUERY=robinhood
DEX_API_BASE=https://api.dexscreener.com

# --- binance_shorts: 15m Binance USDT-M futures short-setup scanner ---
# Which provider /shortscan uses: "mock" (default demo data) or "binance"
# (real public REST market data -- no API key needed, read-only).
BINANCE_SOURCE=mock

# Binance geo/IP-blocks most cloud and datacenter IP ranges at the CDN
# edge (a 451 citing its Terms of Service, before the request reaches an
# app server) -- if that happens from your host, set this to an
# HTTP/HTTPS/SOCKS proxy URL with an eligible egress IP to route around
# it, e.g. http://user:pass@host:port or socks5h://host:port (SOCKS
# needs the optional `pysocks` package). Leave blank to connect directly.
BINANCE_PROXY_URL=

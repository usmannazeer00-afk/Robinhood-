# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Which provider /newpair uses: "mock" (default demo data), "onchain"
# (real PoolCreated watcher on Robinhood Chain, recommended), or
# "dexscreener" (name-search only, limited — see README).
SNIPER_SOURCE=mock

# Robinhood Chain RPC endpoint for the onchain provider. Defaults to the
# public rate-limited endpoint; set this to a dedicated RPC (Alchemy,
# etc.) for heavier polling.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# DexScreener chain id and search query, used by the dexscreener provider
# and by onchain's DexScreener enrichment step.
DEX_CHAIN_ID=robinhood
DEX_SEARCH_QUERY=robinhood
DEX_API_BASE=https://api.dexscreener.com

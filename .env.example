# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Set to "true" to use the live DexScreener-backed provider instead of
# mock demo data for /newpair.
DEX_LIVE=false

# DexScreener chain id once Robinhood Chain is indexed there, and the
# search query used to surface its pairs (defaults to the chain id).
DEX_CHAIN_ID=robinhood
DEX_SEARCH_QUERY=robinhood
DEX_API_BASE=https://api.dexscreener.com
